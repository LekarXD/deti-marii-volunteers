# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.
BOT_TOKEN=
# Код для входа координатора: /coordinator <код>
COORDINATOR_CODE=
# TODO: заменить на анкету на сайте фонда. Сейчас — Яндекс-форма фонда
ANKETA_URL=https://forms.yandex.ru/u/691b104e49af47a8c29589c3/
# Тихие часы: 22-9 по умолчанию, off — выключить (для тестов)
QUIET_HOURS=22-9

# --- Вход по почте через Unisender Go ---
# Пока ключ пуст — тестовый режим: письмо не уходит, код показывается в чате, письмо сохраняется в data/emails/
UNISENDER_API_KEY=
# go1 или go2 — зависит от того, где создан аккаунт Unisender Go
UNISENDER_API_URL=https://go1.unisender.ru/ru/transactional/api/v1/email/send.json
# TODO: адрес фонда, подтверждённый в Unisender Go
UNISENDER_FROM_EMAIL=
UNISENDER_FROM_NAME=Фонд «Дети Марии»
# TODO: id шаблона в Unisender Go, если макет письма заведут там; иначе уходит email_templates/login_code.html
UNISENDER_TEMPLATE_ID=

# --- Сайт фонда ---
# TODO: API для поиска анкеты по почте (см. opora_bot/site.py). Пока пусто — любая почта считается зарегистрированной
SITE_API_URL=
SITE_API_TOKEN=

# --- Платформа «Опора» (сайт фонда) ---
# Когда все три заданы: человек подключает Telegram в профиле на сайте («Обо мне» → «Подключить Telegram»),
# бот берёт его данные из платформы, вход по почте в боте не нужен. Секреты — те же, что в настройках платформы
# (OPORA_TELEGRAM_BOT_API_SECRET и OPORA_TELEGRAM_WEBHOOK_SECRET). Пока пусто — прежний режим.
# OPORA_URL — прямой адрес API (http://api:8001 на сервере, http://127.0.0.1:8001 локально), не адрес сайта: снаружи служебные адреса бота закрыты.
OPORA_URL=
OPORA_BOT_API_SECRET=
OPORA_WEBHOOK_SECRET=

# Тестовый режим: кнопка «Сбросить диалог (тест)» и /reset. На рабочем сервере — off
TEST_MODE=off
